# ====== Server ======
PORT=3000
HOST=0.0.0.0

# Kunci rahasia. Kosongkan = dibuat otomatis & disimpan di data/secrets.json (dicetak saat start)
ADMIN_API_KEY=
ROBLOX_API_KEY=

# ====== TikTok ======
# Isi untuk auto-connect saat server start (tanpa @). Boleh dikosongkan, connect lewat dashboard.
TIKTOK_USERNAME=
# Opsional: API key Euler Stream (sign server) supaya koneksi lebih stabil
TIKTOK_SIGN_API_KEY=
# Opsional: sessionid cookie TikTok (untuk akses tertentu / mengurangi limit)
TIKTOK_SESSION_ID=
# true = tunggu terus sampai akun itu live, lalu connect otomatis
TIKTOK_WAIT_FOR_LIVE=true

# ====== Antrean ======
MAX_QUEUE_SIZE=300
# Detik sebelum job yang di-claim Roblox tapi tidak di-ack dikembalikan ke antrean
CLAIM_LEASE_SECONDS=30
# Detik sebelum event yang tidak diambil Roblox dianggap basi (expired)
EVENT_TTL_SECONDS=180
MAX_ATTEMPTS=3

# Rate limit per IP (request per menit) untuk endpoint dashboard/simulasi
RATE_LIMIT_PER_MINUTE=240
